APP_NAME="REPLACE_PRODUCT_NAME"
APP_ENV=production
APP_KEY=REPLACE_WITH_UNIQUE_APP_KEY
APP_DEBUG=false
APP_URL=https://REPLACE_SUBDOMAIN.kernelbridge.com

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=REPLACE_DATABASE
DB_USERNAME=REPLACE_DATABASE_USER
DB_PASSWORD=REPLACE_DATABASE_PASSWORD

SESSION_DRIVER=redis
SESSION_CONNECTION=default
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=REPLACE_SUBDOMAIN.kernelbridge.com

CACHE_STORE=redis
CACHE_PREFIX=REPLACE_PRODUCT_cache
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=REPLACE_REDIS_PASSWORD
REDIS_PORT=6379
REDIS_DB=REPLACE_REDIS_DB
REDIS_CACHE_DB=REPLACE_REDIS_CACHE_DB
REDIS_QUEUE_CONNECTION=default
REDIS_QUEUE=REPLACE_PRODUCT:default
REDIS_NOTIFICATION_QUEUE=REPLACE_PRODUCT:notifications
REDIS_QUEUE_RETRY_AFTER=180

KERNELBRIDGE_API_URL=https://kernelbridge.com/api/v1
KERNELBRIDGE_PRODUCT_CODE=REPLACE_PRODUCT_CODE
KERNELBRIDGE_API_TOKEN=REPLACE_WITH_PRODUCT_SPECIFIC_MACHINE_TOKEN
KERNELBRIDGE_API_TIMEOUT=10
KERNELBRIDGE_API_CONNECT_TIMEOUT=3
KERNELBRIDGE_VERIFICATION_INTERVAL=15
KERNELBRIDGE_OFFLINE_GRACE_HOURS=72
KERNELBRIDGE_CACHE_SIGNING_KEY=REPLACE_WITH_SEPARATE_RANDOM_SIGNING_KEY

MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=REPLACE_SMTP_HOST
MAIL_PORT=587
MAIL_USERNAME=REPLACE_SMTP_USERNAME
MAIL_PASSWORD=REPLACE_SMTP_PASSWORD
MAIL_FROM_ADDRESS=REPLACE_PRODUCT@kernelbridge.com
MAIL_FROM_NAME="${APP_NAME}"

FILESYSTEM_DISK=local
BCRYPT_ROUNDS=12
