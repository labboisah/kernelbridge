[program:{{APP}}-worker]
process_name=%(program_name)s_%(process_num)02d
command=/usr/bin/php /var/www/{{APP}}/current/artisan queue:work redis --queue={{APP}}:notifications,{{APP}}:default --sleep=3 --tries=3 --backoff=10 --timeout=120 --max-time=3600
directory=/var/www/{{APP}}/current
user={{APP}}
numprocs=1
autostart=true
autorestart=true
stopasgroup=true
killasgroup=true
redirect_stderr=true
stdout_logfile=/var/log/supervisor/{{APP}}-worker.log
stdout_logfile_maxbytes=20MB
stdout_logfile_backups=5
stopwaitsecs=3600
environment=APP_ENV="production"
