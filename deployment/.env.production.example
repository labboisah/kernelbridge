APP_NAME="KernelBridge Technologies"
APP_ENV=production
APP_KEY=GENERATE_WITH_php_artisan_key_generate
APP_DEBUG=false
APP_URL=https://kernelbridge.com
APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=redis

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=30

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kernelbridge_db
DB_USERNAME=kernelbridge
DB_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD

SESSION_DRIVER=redis
SESSION_CONNECTION=default
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=.kernelbridge.com

CACHE_STORE=redis
CACHE_PREFIX=kernelbridge_prod_cache
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=REPLACE_WITH_REDIS_PASSWORD
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_CONNECTION=default
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=180

DASHBOARD_CACHE_STORE=redis
DASHBOARD_CACHE_TTL=300

FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=REPLACE_WITH_SMTP_HOST
MAIL_PORT=587
MAIL_USERNAME=REPLACE_WITH_SMTP_USERNAME
MAIL_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
MAIL_FROM_ADDRESS=hello@kernelbridge.com
MAIL_FROM_NAME="${APP_NAME}"

BROADCAST_CONNECTION=log
BCRYPT_ROUNDS=12
LICENSE_REMINDER_DAYS=30
STALE_LEAD_DAYS=3
DEMO_SESSION_RETENTION_HOURS=24

SUPER_ADMIN_NAME="KernelBridge Super Administrator"
SUPER_ADMIN_EMAIL=admin@kernelbridge.com
SUPER_ADMIN_PASSWORD=REPLACE_ONLY_FOR_INITIAL_SEED_THEN_REMOVE

VITE_APP_NAME="${APP_NAME}"
